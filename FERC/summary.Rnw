## Inspect over-trimmed company names
FERC_corps %>% filter(company_short %in% c("", "LLC", "Energy", "Pipeline", "Natural", "North", "New", "Express", "American", "Electric", "System", "Direct", "DC", "PS", "CT", "Forest", "International", "Tennessee", "Salt Lake", "Lakeside", "NW", "Jackson", "Public Service", "Peak", "Independence", "Select", "Portland", "Michigan", "Boundary", "Coastal", "Minnesota", "Midwest", "Columbia", "Plains", "Stream", "Mitchell", "AP", "Southern", "Ohio River", "Northwest", "Rio Grande", "AI", "Transportation", "12/20/2018", "Salem", "Boston", "Spokane", "El Paso", "Houston", "North American", "Consumers", "Advanced", "Complete", "Inland", "Limited Partnership", "RTO")) %>% select(company_short)

FERC_corps %>% filter(str_detect(company_short, ","))

FERC_corps %>% group_by(company_short) %>% tally() %>% arrange(-n) 

FERC_corps %>% group_by(company_short) %>% tally() %>% arrange(nchar(company_short)) %>% mutate(nchar = nchar(company_short))

FERC_corps %>% group_by(company_short) %>% tally() %>% arrange(-nchar(company_short)) 
